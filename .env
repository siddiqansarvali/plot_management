# ============================================================
# AI Plot Layout Management System - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_TITLE="AI Plot Layout Management"
APP_VERSION="1.0.0"
DEBUG=false

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./plotlayout.db

# --- File Storage ---
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_FILE_SIZE_MB=50

# --- OpenRouter Vision LLM ---
# Get your key at: https://openrouter.ai/
# IMPORTANT: Keep this key secret. It must NEVER be sent to the frontend.
OPENROUTER_API_KEY=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
VISION_MODEL=openrouter/free

# --- Vision Model ---
# Must be a vision-capable model available on OpenRouter.
# Examples:
#   google/gemini-2.0-flash-001          (fast, good vision)
#   google/gemini-2.5-pro                (more accurate)
#   anthropic/claude-3.5-sonnet          (excellent reasoning)
#   openai/gpt-4o                        (strong vision)
# The chosen model MUST support image inputs.

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Analysis Pipeline Feature Flags ---
# Set to false to disable a component (useful for debugging or if not installed)
ENABLE_OCR=true
ENABLE_LLM=true
ENABLE_YOLO=false

# --- YOLO ---
# Path to YOLO model weights. Use a pretrained or custom-trained model.
# ENABLE_YOLO=false until a survey-specific model is available.
YOLO_MODEL=yolov8n.pt

# --- OCR ---
OCR_LANGUAGE=en

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Confidence Thresholds ---
# Minimum confidence to report geometry as "detected" (0.0–1.0)
MIN_GEOMETRY_CONFIDENCE=0.50
# Minimum OCR confidence to include a text result
MIN_OCR_CONFIDENCE=0.60
