# ============================================================
# AI Plot Layout Management System - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_TITLE="AI Plot Layout Management"
APP_VERSION="1.0.0"
DEBUG=false

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./plotlayout.db

# --- File Storage ---
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_FILE_SIZE_MB=50

# --- OpenRouter Vision LLM ---
# Get your key at: https://openrouter.ai/
# IMPORTANT: Keep this key secret. It must NEVER be sent to the frontend.
OPENROUTER_API_KEY=

# --- Vision Model ---
# The free router supports image input; a named provider/model is checked
# against OpenRouter's advertised input modalities before any image is sent.
VISION_MODEL=openrouter/free

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Analysis Pipeline Feature Flags ---
# Set to false to disable a component (useful for debugging or if not installed)
ENABLE_OCR=true
ENABLE_LLM=true
ENABLE_YOLO=false

# --- YOLO ---
# Optional path to a survey-specific model. Generic pretrained object models
# are deliberately rejected because they do not identify cadastral plots.
YOLO_MODEL=
# Comma-separated class names defined by that survey-specific model.
YOLO_ALLOWED_CLASSES=

# --- OCR ---
OCR_LANGUAGE=en

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Confidence Thresholds ---
# Minimum confidence to report geometry as "detected" (0.0–1.0)
MIN_GEOMETRY_CONFIDENCE=0.50
# Minimum OCR confidence to include a text result
MIN_OCR_CONFIDENCE=0.60
