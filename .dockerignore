# Version control
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
backend/env/
backend/venv/
backend/.pytest_cache/
backend/tests/__pycache__/
backend/app/**/__pycache__/
*.db
*.sqlite
*.sqlite3

# Node / Frontend
frontend/node_modules/
frontend/.npm/
frontend/dist/
frontend/.vite/

# Temporary and local files
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
*.log
scratch/
test_three_images.py
cloudflared.exe
.env
